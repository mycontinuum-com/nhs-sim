# Copy to .env. These defaults are local development only.
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=local-database-change-me
OPERATOR_TOKEN=local-operator-change-me
# Traefik: set PUBLIC_ORIGIN=https://your-host and SIM_HOST=your-host
SIM_HOST=nhs-sim.example.com
TRAEFIK_CERTRESOLVER=letsencrypt
# Optional, billed model proposals; never required for normal simulation.
OPENAI_API_KEY=
OPENAI_MODEL=
